{
  "manifest_version": 3,
  "name": "ZEN Study Downloader (動画＆スライド＆確認テスト一括保存)",
  "version": "1.1.0",
  "description": "ZEN大学の講義動画・講義スライド画像・確認テスト（解答解説付き）を1クリックで全章一括ダウンロード・自動整理する公式受講生向け支援ツール",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "*://www.nnn.ed.nico/*",
    "*://api.nnn.ed.nico/*",
    "*://cdn-private.nnn.ed.nico/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.nnn.ed.nico/courses/*",
        "*://www.nnn.ed.nico/contents/courses/*"
      ],
      "js": [
        "html2canvas.min.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZEN Study Downloader 設定",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
